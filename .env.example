ANTHROPIC_API_KEY=your_api_key_here
DEFAULT_LANGUAGE=german
DATA_DIR=./data

# Azure Speech Service for pronunciation audio features
# Get your key from: https://portal.azure.com/#view/Microsoft_Azure_ProjectOxford/CognitiveServicesHub/~/SpeechServices
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus
# Common regions: eastus, westeurope, southeastasia, eastasia
